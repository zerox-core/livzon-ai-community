# 飞书自建应用凭证（SSO 登录 + 机器人通知共用）
# 在飞书开放平台 https://open.feishu.cn/app 创建企业自建应用后获取
# 应用需开启「网页应用」+「机器人」能力，并发布版本
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 服务端口（默认 8787）
PORT=8787

# ===== 飞书 SSO 登录（authen/v2）=====
# 应用能力需含「网页应用」，并在「安全设置」登记回调 URL。
# 换 token 会原样回传此 redirect_uri（缺失报 20063）。默认本机 127.0.0.1。
LARK_LOGIN_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback
# 新版「网页应用」登录流程已取消 scope；仅老式授权应用才需填 LARK_LOGIN_SCOPE（留空即不传）。
# LARK_LOGIN_SCOPE=authen:user.id:read

# ===== 机器人单聊消息（活动提醒，im:message:send_as_bot）=====
# 无需额外变量：复用上面的 APP_ID/APP_SECRET + 「机器人」能力 + im:message:send_as_bot 权限。

# ===== 管理员白名单 =====
# 逗号分隔的飞书 open_id（ou_ 开头）。命中者登录后自动「只升不降」提升为 admin。
# 存量账号也可跑：node server/sql/seed_admin.js  （或 --promote/--demote/--list）
ADMIN_OPEN_IDS=

# 站点对外基地址（飞书卡片按钮/精华推送跳转用）=====
# 必须是「用户设备可访问」的内网地址（如 http://192.168.0.100:8787），不能写 127.0.0.1。
# 换网络（热点↔公司WiFi）后同步更新。留空则提醒卡片退化为无按钮的纯信息卡。
SITE_INTRANET_URL=

# ===== 作品制品上传 =====
# 单文件上传大小上限（MB），默认 50。落盘 public/uploads/artifacts/（后续可平替对象存储）。
ARTIFACT_MAX_MB=50

# ===== 资源(asset)子系统上传 =====
# 跨端复用资源上传大小上限（MB），默认 50；社区/活动报名/制品/程序 共用。
# 落盘统一 public/uploads/assets/<category>/。四分类：program/skill/media/doc。
ASSET_MAX_MB=50

# ===== Agent 自动化回填 =====
# agent 在内网完成「推 gitlab / 提交资源中心」后，调用 POST /api/assets/agent-register 回填登记。
# 请求头 x-agent-token 必须与此值一致（timingSafeEqual 比对）；留空 = 接口停用（501）。
# 生成方式示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=

# ===== 活动开始提醒定时任务 =====
# 关闭整个提醒扫描：0（默认启用）
REMINDERS_ENABLED=1
# cron 表达式（默认每小时整点）；测试可临时改 '*/1 * * * *' 每分钟
REMINDER_CRON=0 * * * *
# 活动开始前多少小时提醒（默认 24）；依赖 activities.start_at
REMIND_AHEAD_HOURS=24

# ===== 会话安全 =====
# 生产务必设为强随机串；dev-login 仅非生产可用
# SESSION_SECRET=
# 生产设为 production（关闭 dev-login 与旧 x-user-role 头）
# NODE_ENV=production
# 显式允许 dev-login（非生产默认已开）：ALLOW_DEV_LOGIN=1
# ALLOW_DEV_LOGIN=
